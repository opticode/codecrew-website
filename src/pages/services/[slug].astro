---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import Badge from '../../components/ui/Badge.astro';
import { services } from '../../data/content';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={`${service.title} — CodeCrew Software`} description={service.description}>
  <section class="py-20 md:py-32 px-4">
    <div class="max-w-3xl mx-auto">
      <a href="/#services" class="inline-flex items-center gap-2 text-primary text-sm mb-12 hover:opacity-80 transition-opacity font-heading tracking-wide">
        <Icon name="lucide:arrow-left" class="w-4 h-4" />
        Back to Services
      </a>

      <div class="flex items-start gap-5 mb-8">
        <div class="w-14 h-14 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
          <Icon name={service.icon} class="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-2xl md:text-3xl mb-2 font-heading">
            {service.title}
          </h1>
          {service.badge && <Badge text={service.badge} />}
        </div>
      </div>

      <div class="prose">
        {service.longDescription.split('\n\n').map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="mt-16 pt-8 border-t border-white/10">
        <p class="text-text-muted mb-6 font-heading text-[0.95rem]">
          Interested in this service?
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/#contact" class="btn-primary">
            Get in Touch
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
          {service.url && (
            <a href={service.url} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Visit {service.title}
              <Icon name="lucide:external-link" class="w-4 h-4" />
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
