---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="py-20 md:py-32 px-4 bg-[var(--color-surface)]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="section-heading">Latest from the Blog</h2>
      <p class="section-subheading">
        Thoughts on software development, AI, and building great products.
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            basePath="/blog"
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="text-center text-[var(--color-text-muted)]">
        Blog posts coming soon. Stay tuned!
      </p>
    )}

    {posts.length > 0 && (
      <div class="text-center mt-12">
        <a href="/blog" class="btn-secondary">View All Posts</a>
      </div>
    )}
  </div>
</section>
