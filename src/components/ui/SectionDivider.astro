---
interface Props {
  flip?: boolean;
}
const { flip = false } = Astro.props;
---

<div class={`w-full overflow-hidden leading-[0] ${flip ? 'rotate-180' : ''}`}>
  <svg viewBox="0 0 1200 80" preserveAspectRatio="none" class="w-full h-12 md:h-20" fill="var(--color-base)">
    <path d="M0,0 C300,80 900,0 1200,80 L1200,80 L0,80 Z" opacity="0.6" fill="var(--color-surface)" />
    <path d="M0,40 C400,0 800,80 1200,20 L1200,80 L0,80 Z" fill="var(--color-base)" />
  </svg>
</div>
