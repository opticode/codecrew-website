---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<span class="inline-block px-3 py-1 text-xs tracking-wider uppercase rounded-full bg-[var(--color-secondary)]/15 text-[var(--color-secondary)] border border-[var(--color-secondary)]/30" style="font-family: var(--font-heading);">
  {text}
</span>
