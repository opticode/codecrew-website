---
---

<div class="hero-gradient absolute inset-0 -z-10">
  <!-- Radial glow overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,229,255,0.08)_0%,transparent_70%)]"></div>
  <!-- Floating shapes -->
  <div class="absolute top-[15%] left-[10%] text-[var(--color-primary)]/10 text-6xl" style="animation: float 8s ease-in-out infinite;">
    &lt;
  </div>
  <div class="absolute top-[25%] right-[15%] text-[var(--color-primary)]/8 text-4xl" style="animation: float-reverse 10s ease-in-out infinite;">
    &gt;
  </div>
  <div class="absolute bottom-[20%] left-[20%] w-2 h-2 rounded-full bg-[var(--color-primary)]/20" style="animation: float-slow 6s ease-in-out infinite;"></div>
  <div class="absolute top-[40%] right-[25%] w-3 h-3 rounded-full bg-[var(--color-primary)]/15" style="animation: float 9s ease-in-out infinite 1s;"></div>
  <div class="absolute bottom-[35%] right-[10%] text-[var(--color-primary)]/6 text-3xl" style="animation: float-slow 7s ease-in-out infinite 0.5s;">
    /&gt;
  </div>
  <div class="absolute top-[60%] left-[8%] w-1.5 h-1.5 rounded-full bg-[var(--color-secondary)]/20" style="animation: float-reverse 8s ease-in-out infinite 2s;"></div>
  <div class="absolute top-[10%] left-[50%] w-2 h-2 rounded-full bg-[var(--color-primary)]/10" style="animation: float 11s ease-in-out infinite 0.5s;"></div>
</div>
