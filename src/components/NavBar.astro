---
import NavMobile from './NavMobile.vue';

const links = [
  { href: '/#services', label: 'Services' },
  { href: '/#edge', label: 'Our Edge' },
  { href: '/#about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-base/80 backdrop-blur-lg border-b border-white/[0.05]">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 md:h-20">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <svg viewBox="0 0 82 80" class="w-8 h-8 md:w-10 md:h-10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6 40 L22 18 M6 40 L22 62" stroke="#00e5ff" stroke-width="5" fill="none" stroke-linecap="round"/>
        <circle cx="41" cy="28" r="5" fill="#66f0ff"/>
        <circle cx="29" cy="40" r="5" fill="#66f0ff"/>
        <circle cx="53" cy="40" r="5" fill="#66f0ff"/>
        <circle cx="41" cy="52" r="5" fill="#66f0ff"/>
        <circle cx="41" cy="40" r="5" fill="#009db3"/>
        <path d="M76 40 L60 18 M76 40 L60 62" stroke="#00e5ff" stroke-width="5" fill="none" stroke-linecap="round"/>
      </svg>
      <span class="text-sm md:text-base tracking-[0.2em] text-white" style="font-family: var(--font-heading);">
        CODECREW
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile Nav -->
    <NavMobile client:load links={links} />
  </nav>
</header>
