---
import GradientBackground from './ui/GradientBackground.astro';
import { siteConfig } from '../data/content';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <GradientBackground />

  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto stagger-in">
    <!-- Animated Logo -->
    <div class="flex items-center justify-center mb-8">
      <svg viewBox="0 0 82 80" class="logo-svg w-20 h-20 md:w-28 md:h-28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g class="logo-bracket-left-group">
          <path d="M6 40 L22 18 M6 40 L22 62" stroke="#00e5ff" stroke-width="5" fill="none" stroke-linecap="round" class="logo-bracket-left"/>
        </g>
        <g class="logo-crew">
          <circle cx="41" cy="28" r="5" fill="#66f0ff" class="logo-dot"/>
          <circle cx="29" cy="40" r="5" fill="#66f0ff" class="logo-dot"/>
          <circle cx="53" cy="40" r="5" fill="#66f0ff" class="logo-dot"/>
          <circle cx="41" cy="52" r="5" fill="#66f0ff" class="logo-dot"/>
        </g>
        <circle cx="41" cy="40" r="5" fill="#009db3" class="logo-dot logo-center"/>
        <g class="logo-bracket-right-group">
          <path d="M76 40 L60 18 M76 40 L60 62" stroke="#00e5ff" stroke-width="5" fill="none" stroke-linecap="round" class="logo-bracket-right"/>
        </g>
      </svg>
    </div>

    <!-- Logo Text -->
    <h1 class="logo-text-anim text-2xl md:text-4xl tracking-[0.2em] mb-6 font-heading text-text-heading">
      CODECREW
    </h1>

    <!-- Tagline -->
    <p class="text-lg md:text-2xl text-primary mb-6 font-heading text-[clamp(0.9rem,2.5vw,1.35rem)]">
      {siteConfig.tagline}
    </p>

    <!-- Description -->
    <p class="text-base md:text-lg max-w-2xl mx-auto mb-10 leading-relaxed text-[#a8a8b8]">
      {siteConfig.description}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#services" class="btn-primary">Explore Our Services</a>
      <a href="#contact" class="btn-secondary">Get In Touch</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-40" style="animation: float 3s ease-in-out infinite;">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>
</section>
