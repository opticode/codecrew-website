---
import { Icon } from 'astro-icon/components';
import Badge from './ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  badge?: string | null;
  slug: string;
}

const { title, description, icon, badge, slug } = Astro.props;
---

<a href={`/services/${slug}`} class="glass-card shimmer-border rounded-xl p-6 md:p-8 flex flex-col h-full no-underline group">
  <div class="flex items-start justify-between mb-4">
    <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
      <Icon name={icon} class="w-6 h-6" />
    </div>
    {badge && <Badge text={badge} />}
  </div>
  <h3 class="text-lg mb-3 font-heading text-[clamp(0.95rem,1.5vw,1.1rem)]">
    {title}
  </h3>
  <p class="text-text-muted text-base leading-relaxed flex-1">
    {description}
  </p>
  <span class="mt-4 text-primary text-sm font-medium opacity-70 group-hover:opacity-100 transition-opacity font-heading">
    Learn more &rarr;
  </span>
</a>
