---
import { about } from '../data/content';
---

<section id="about" class="py-20 md:py-32 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="section-heading mb-8">{about.heading}</h2>

    {about.text.split('\n\n').map((paragraph) => (
      <p class="text-text-muted text-base md:text-lg leading-relaxed mb-6 max-w-3xl mx-auto">
        {paragraph}
      </p>
    ))}

    <!-- Tech stack -->
    <div class="mt-12">
      <p class="text-xs uppercase tracking-[0.2em] text-text-muted mb-6" style="font-family: var(--font-heading);">
        Technologies We Work With
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {about.techStack.map((tech) => (
          <span class="px-4 py-2 rounded-lg text-sm bg-surface border border-border text-text-muted hover:text-primary hover:border-primary/30 transition-colors" style="animation: float-slow 6s ease-in-out infinite; animation-delay: calc(var(--i, 0) * 0.3s);">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
