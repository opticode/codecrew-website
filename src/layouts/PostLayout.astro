---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
}

const { title, description, date, tags = [], image } = Astro.props;

const formattedDate = date.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Rough reading time from word count
const readingTime = Math.max(1, Math.ceil((Astro.slots.has('default') ? 200 : 200) / 200));
---

<BaseLayout title={`${title} — CodeCrew Blog`} description={description} image={image}>
  <article class="pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto">
      <header class="mb-12">
        <a href="/blog" class="text-primary text-sm tracking-wider hover:underline mb-6 inline-block font-heading">
          &larr; Back to Blog
        </a>
        <h1 class="text-3xl md:text-4xl font-bold mb-4 font-heading">{title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {tags.length > 0 && (
            <div class="flex gap-2">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full text-xs bg-surface-light text-primary border border-border">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
