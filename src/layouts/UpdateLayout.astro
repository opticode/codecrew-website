---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  type?: 'feature' | 'announcement' | 'milestone';
}

const { title, description, date, type = 'announcement' } = Astro.props;

const formattedDate = date.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const typeColors: Record<string, string> = {
  feature: 'text-green-400 bg-green-400/10 border-green-400/30',
  announcement: 'text-[var(--color-primary)] bg-[var(--color-primary)]/10 border-[var(--color-primary)]/30',
  milestone: 'text-[var(--color-secondary)] bg-[var(--color-secondary)]/10 border-[var(--color-secondary)]/30',
};
---

<BaseLayout title={`${title} — CodeCrew Updates`} description={description}>
  <article class="pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto">
      <header class="mb-12">
        <a href="/updates" class="text-[var(--color-primary)] text-sm font-[var(--font-heading)] tracking-wider hover:underline mb-6 inline-block">
          &larr; Back to Updates
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class={`px-3 py-1 rounded-full text-xs border capitalize ${typeColors[type]}`}>
            {type}
          </span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">{title}</h1>
        <time datetime={date.toISOString()} class="text-sm text-[var(--color-text-muted)]">{formattedDate}</time>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
